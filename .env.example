# Copy to .env (git-ignored) or set in your OS environment. Names only — no real values here.
AEGIS_TRADING_MODE=paper            # paper | demo   (live is locked in this release)
AEGIS_DATA_DIR=./var
AEGIS_SYMBOLS=EURUSD,GBPUSD,USDJPY
AEGIS_TELEGRAM_SOURCES=             # numeric IDs of channels/groups whose signals you trust
AEGIS_TELEGRAM_INTAKE_CHATS=        # numeric IDs of chats the bot listens in (channels + your private group)
AEGIS_TELEGRAM_TRUSTED_USERS=       # numeric user IDs allowed to post/forward into the private group
AEGIS_TELEGRAM_BOT_TOKEN=           # from @BotFather. Set in your OS user env / Credential Manager, NEVER here.
# Windows / MT5 demo only (Stage 4):
AEGIS_MT5_TERMINAL_PATH=            # e.g. C:\Program Files\MetaTrader 5\terminal64.exe
# Prefer the OS secret store (Windows Credential Manager) for tokens; never commit them.
